# Where your mailcow lives (no trailing slash, no /api/v1)
MAILCOW_URL=https://mail.example.com

# In the mailcow UI: System > Configuration > Access > API, read-write key.
# Add the IP this app connects from to the key's "allow API access from" list.
MAILCOW_API_KEY=

# Set to 1 only if mailcow uses a self-signed certificate
MAILCOW_TLS_INSECURE=0

# Login for this UI. Generate the hash with: npm run hash-password
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Long random string used to sign session cookies: openssl rand -hex 32
SESSION_SECRET=

# Set to 1 when the UI is served over HTTPS (recommended), so cookies are Secure-only
COOKIE_SECURE=1
SESSION_HOURS=12
PORT=3000

# Dashboard alert when a newer mailcow release is on GitHub (checked every 6 hours).
# Set to 0 to turn it off, e.g. if this server has no internet access.
UPDATE_CHECK=1
