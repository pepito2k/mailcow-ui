{
  "name": "mailcow-ui",
  "version": "0.1.0",
  "description": "A modern admin UI for mailcow",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "mock": "tsx mock/server.ts",
    "demo": "concurrently -k -n mock,server,web \"npm:mock\" \"MAILCOW_URL=http://localhost:8081 MAILCOW_API_KEY=mock-key ADMIN_USER=admin ADMIN_PASSWORD=admin SESSION_SECRET=demo-secret-demo-secret-demo-secret tsx watch server/index.ts\" \"npm:dev:web\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "hash-password": "tsx server/hash-password.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@tanstack/react-query": "^5.108.1",
    "express": "^5.3.0",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  },
  "private": true,
  "type": "module"
}
